{
  "compilerOptions": {
    "module": "NodeNext",
    "strict": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "..",
    "target": "ES2022",
    "declaration": true
  },
  "include": ["src/**/*.ts", "./../shared/**/*.ts"],
  "exclude": ["src/**/__tests__/*", "../shared/**/__tests__/*", "vitest.config.ts"]
}
